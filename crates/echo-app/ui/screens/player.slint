// Echo Music Desktop — full-screen player.
//
// Recreates the upstream "Liquid Glass" player: a tinted gradient backdrop, the
// large rounded artwork, the transport row with the Echo flower play button,
// and the synchronised lyrics panel with the active line highlighted.

import { Theme } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";
import { CoverArt, IconButton, LyricLineData, SongData } from "../components.slint";

/// The Echo clover mark, used for the primary play control.
component EchoFlower inherits Rectangle {
    callback clicked();

    in property <length> size: 68px;
    in property <color> tint: #ffffff;
    in property <string> glyph: "▶";
    in property <color> glyph-color: Theme.primary-container;

    width: size;
    height: size;
    background: transparent;

    Rectangle {
        x: 0; y: 0;
        width: parent.width * 0.58; height: parent.height * 0.58;
        border-radius: self.width / 2; background: root.tint;
    }
    Rectangle {
        x: parent.width * 0.42; y: 0;
        width: parent.width * 0.58; height: parent.height * 0.58;
        border-radius: self.width / 2; background: root.tint;
    }
    Rectangle {
        x: 0; y: parent.height * 0.42;
        width: parent.width * 0.58; height: parent.height * 0.58;
        border-radius: self.width / 2; background: root.tint;
    }
    Rectangle {
        x: parent.width * 0.42; y: parent.height * 0.42;
        width: parent.width * 0.58; height: parent.height * 0.58;
        border-radius: self.width / 2; background: root.tint;
    }

    Text {
        text: root.glyph;
        color: root.glyph-color;
        font-size: root.size * 0.32;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

/// A draggable seek bar.
component SeekBar inherits Rectangle {
    in property <float> progress: 0.0;
    callback seek(float);

    height: 22px;
    background: transparent;

    Rectangle {
        y: parent.height / 2 - 2px;
        height: 4px;
        width: parent.width;
        border-radius: 2px;
        background: Theme.surface-variant;
    }
    Rectangle {
        y: parent.height / 2 - 2px;
        height: 4px;
        width: parent.width * clamp(root.progress, 0.0, 1.0);
        border-radius: 2px;
        background: Theme.on-surface;
    }
    Rectangle {
        x: parent.width * clamp(root.progress, 0.0, 1.0) - 6px;
        y: parent.height / 2 - 6px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.on-surface;
    }

    TouchArea {
        moved => { root.seek(clamp(self.mouse-x / self.width, 0.0, 1.0)); }
        clicked => { root.seek(clamp(self.mouse-x / self.width, 0.0, 1.0)); }
    }
}

export component PlayerScreen inherits Rectangle {
    in property <SongData> song;
    in property <bool> playing: false;
    in property <bool> liked: false;
    in property <bool> downloaded: false;
    in property <bool> shuffle: false;
    in property <int> repeat-mode: 0;
    in property <float> progress: 0.0;
    in property <string> position-label: "0:00";
    in property <string> duration-label: "0:00";
    in property <bool> lyrics-visible: true;
    in property <[LyricLineData]> lyrics: [];
    in property <string> lyrics-source: "";
    in property <string> subtitle: "";

    callback close();
    callback toggle-play();
    callback next();
    callback previous();
    callback seek(float);
    callback toggle-shuffle();
    callback cycle-repeat();
    callback toggle-like();
    callback toggle-download();
    callback toggle-lyrics();
    callback lyrics-source-clicked();

    background: @linear-gradient(165deg, Theme.primary-container 0%, Theme.background 55%, Theme.background 100%);

    VerticalLayout {
        padding: 22px;
        spacing: 16px;

        // ---- header ------------------------------------------------------
        HorizontalLayout {
            spacing: 8px;
            IconButton {
                glyph: "⌄";
                size: 36px;
                font-size: 20px;
                clicked => { root.close(); }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text {
                    text: "Playing from";
                    color: Theme.on-surface-variant;
                    font-size: Theme.font-micro;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.subtitle;
                    color: Theme.on-surface;
                    font-size: Theme.font-label;
                    font-weight: 600;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }
            IconButton {
                glyph: "⚙";
                size: 36px;
                clicked => { root.lyrics-source-clicked(); }
            }
        }

        // ---- artwork -----------------------------------------------------
        CoverArt {
            source: root.song.cover;
            radius: Theme.radius-card;
            height: min(parent.width, 340px);
            width: min(parent.width, 340px);
        }

        // ---- title + actions ---------------------------------------------
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text {
                    text: root.song.title;
                    color: Theme.on-surface;
                    font-size: Theme.font-display;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: root.song.subtitle;
                    color: Theme.on-surface-variant;
                    font-size: Theme.font-body;
                    overflow: elide;
                }
            }
            IconButton {
                glyph: root.liked ? "♥" : "♡";
                size: 40px;
                font-size: 18px;
                tint: root.liked ? Theme.primary : Theme.on-surface;
                background-on: Theme.chip;
                clicked => { root.toggle-like(); }
            }
            IconButton {
                glyph: root.downloaded ? "✓" : "⤓";
                size: 40px;
                font-size: 18px;
                background-on: Theme.chip;
                clicked => { root.toggle-download(); }
            }
        }

        // ---- seek ---------------------------------------------------------
        VerticalLayout {
            spacing: 2px;
            SeekBar {
                progress: root.progress;
                seek(value) => { root.seek(value); }
            }
            HorizontalLayout {
                Text {
                    text: root.position-label;
                    color: Theme.on-surface-variant;
                    font-size: Theme.font-micro;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.duration-label;
                    color: Theme.on-surface-variant;
                    font-size: Theme.font-micro;
                    horizontal-alignment: right;
                }
            }
        }

        // ---- transport -----------------------------------------------------
        HorizontalLayout {
            spacing: 18px;
            alignment: center;

            IconButton {
                glyph: "⤨";
                size: 42px;
                font-size: 17px;
                tint: root.shuffle ? Theme.primary : Theme.on-surface;
                background-on: Theme.chip;
                clicked => { root.toggle-shuffle(); }
            }
            IconButton {
                glyph: "⏮";
                size: 52px;
                font-size: 20px;
                background-on: Theme.chip;
                clicked => { root.previous(); }
            }
            EchoFlower {
                size: 70px;
                glyph: root.playing ? "❙❙" : "▶";
                clicked => { root.toggle-play(); }
            }
            IconButton {
                glyph: "⏭";
                size: 52px;
                font-size: 20px;
                background-on: Theme.chip;
                clicked => { root.next(); }
            }
            IconButton {
                glyph: root.repeat-mode == 2 ? "🔂" : "🔁";
                size: 42px;
                font-size: 15px;
                tint: root.repeat-mode > 0 ? Theme.primary : Theme.on-surface;
                background-on: Theme.chip;
                clicked => { root.cycle-repeat(); }
            }
        }

        // ---- lyrics ---------------------------------------------------------
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Lyrics";
                color: Theme.on-surface;
                font-size: Theme.font-title;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: root.lyrics-source;
                color: Theme.on-surface-variant;
                font-size: Theme.font-micro;
                vertical-alignment: center;
            }
            IconButton {
                glyph: root.lyrics-visible ? "⌃" : "⌄";
                size: 32px;
                clicked => { root.toggle-lyrics(); }
            }
        }

        if root.lyrics-visible : ScrollView {
            vertical-stretch: 1;
            horizontal-scrollbar-policy: always-off;

            VerticalLayout {
                spacing: 10px;
                padding-bottom: 20px;
                for line[index] in root.lyrics : VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: line.text;
                        color: line.is-active ? Theme.on-surface : Theme.on-surface-variant.with-alpha(0.55);
                        font-size: line.is-active ? Theme.font-title : Theme.font-body;
                        font-weight: line.is-active ? 700 : 400;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                        animate color { duration: 220ms; }
                    }
                    Text {
                        text: line.translation;
                        color: Theme.on-surface-variant;
                        font-size: Theme.font-label;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                        visible: line.translation != "";
                    }
                }
            }
        }

        if !root.lyrics-visible : Text {
            text: root.lyrics.length == 0 ? "No lyrics found for this track." : "";
            color: Theme.on-surface-variant;
            font-size: Theme.font-label;
            horizontal-alignment: center;
            vertical-stretch: 1;
        }
    }
}
