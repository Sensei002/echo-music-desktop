# Rust
/target
**/*.rs.bk
*.pdb

# Cargo.lock is committed on purpose. This is a workspace whose default member
# is a binary (`echo-app`), so the lockfile is what makes CI and release builds
# reproducible. Do NOT add it here.
!Cargo.lock

# Slint generated code
/crates/echo-app/ui/*.rs

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
.vscode/
*.iml

# Local app data / caches
/.echocache
*.log

# Build output
/dist
/release

# Local agent workspace data
/.workbuddy-ai/
