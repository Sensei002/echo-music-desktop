# Normalise line endings so the repo is consistent across Windows, macOS and
# Linux checkouts. Rust and Slint sources are stored with LF.
* text=auto eol=lf

# Binary assets must never be mangled.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.zip binary
*.gz binary
*.tar binary

# Cargo.lock is committed and is not generated noise - it is the input that
# pins every build. Keep it visible in diffs (no linguist-generated) and do not
# let the text=auto eol=lf rule rewrite it.
Cargo.lock -text
