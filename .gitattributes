# Normalise line endings so the repo is consistent across Windows, macOS and
# Linux checkouts. Rust and Slint sources are stored with LF.
* text=auto eol=lf

# Binary assets must never be mangled.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.zip binary
*.gz binary
*.tar binary

# Lockfiles are generated; keep them out of diffs.
Cargo.lock linguist-generated=true
